// ============================================================================
// መርሃ ህይወት ሰ/ቤት — Sunday School Management System
// Prisma Schema — shared by Student Management/Attendance and Finance dashboards
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum Role {
  ADMINISTRATOR
  ATTENDANCE_OFFICER
  FINANCE_OFFICER
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum ClassLevel {
  CLASS_1_3
  CLASS_4_6
  CLASS_7_12
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  PERMISSION
  LATE
}

enum EventType {
  SUNDAY_SCHOOL
  COURSE
  SPECIAL_OCCASIONS
}

enum EthiopianMonth {
  MESKEREM
  TIKIMT
  HIDAR
  TAHSAS
  TIR
  YEKATIT
  MEGABIT
  MIYAZIA
  GINBOT
  SENE
  HAMLE
  NEHASE
  PAGUME
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

enum IncomeCategory {
  STUDENT_FEES
  DONATIONS
  DEVELOPMENT_DEPART
  OTHERS
  OPENING_BALANCE
  REVERSAL
}

enum ExpenseCategory {
  TEACHING_MATERIALS
  STATIONERY
  SNACKS
  TRANSPORTATION
  EQUIPMENT
  MAINTENANCE
  EVENTS
  CHARITY
  MISCELLANEOUS
  REVERSAL
}

enum NotificationType {
  ATTENDANCE_WARNING
  LONG_ABSENCE
  UPCOMING_INACTIVE
  UNPAID_FEES
  LARGE_EXPENSE
  REPORT_READY
  MISSING_PAYMENT_RECORD
  WEEKLY_DIGEST
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum AccountType {
  CASH
  BANK
}

enum IncomeSourceType {
  STUDENT_FEE
  DONATION
  CHURCH_CONTRIBUTION
  FUNDRAISING
  SPECIAL_OFFERING
  OTHER
}

enum FinanceReportType {
  MONTHLY
  YEARLY
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHEQUE
}

enum TransactionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum ReconciliationStatus {
  MATCHED
  DISCREPANCY_FOUND
  UNDER_INVESTIGATION
  RESOLVED
}

// ----------------------------------------------------------------------------
// USERS & AUTH
// ----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recordedIncomes        Income[]              @relation("IncomeRecordedBy")
  approvedIncomes        Income[]              @relation("IncomeApprovedBy")
  recordedExpenses       Expense[]             @relation("ExpenseRecordedBy")
  approvedExpenses       Expense[]             @relation("ExpenseApprovedBy")
  recordedPayments       MonthlyPayment[]      @relation("PaymentRecordedBy")
  attendanceRecords      Attendance[]          @relation("AttendanceRecordedBy")
  studentsCreated        Student[]             @relation("StudentCreatedBy")
  auditLogs              AuditLog[]
  auditLogsChanged       AuditLog[]            @relation("AuditLogChangedBy")
  notifications          Notification[]
  receiptsIssued         Receipt[]             @relation("ReceiptIssuedBy")
  approvals              TransactionApproval[] @relation("ApprovalApprover")
  reconciliations        Reconciliation[]      @relation("ReconciliationPerformedBy")
  reconciliationResolved Reconciliation[]      @relation("ReconciliationResolvedBy")
  generatedReports       FinanceReport[]       @relation("ReportGeneratedBy")

  @@map("users")
}

// ----------------------------------------------------------------------------
// STUDENTS & CLASSES  (owned by Attendance dashboard, read by Finance)
// ----------------------------------------------------------------------------

model ClassGroup {
  id       String     @id @default(uuid())
  level    ClassLevel @unique
  name     String
  teachers Teacher[]
  students Student[]

  @@map("class_groups")
}

model Teacher {
  id       String       @id @default(uuid())
  fullName String
  phone    String?
  classes  ClassGroup[]

  @@map("teachers")
}

model Student {
  id               String        @id @default(uuid())
  studentCode      String        @unique
  fullName         String
  fullNameAmharic  String?
  gender           Gender
  dateOfBirth      DateTime
  studentPhone     String?
  parentName       String
  parentPhone      String
  registrationDate DateTime      @default(now())
  classId          String
  class            ClassGroup    @relation(fields: [classId], references: [id])
  status           StudentStatus @default(ACTIVE)
  photoUrl         String?
  isWorkingMember  Boolean       @default(false)
  monthlySalary    Decimal?      @db.Decimal(10, 2)
  createdById      String?
  createdBy        User?         @relation("StudentCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  attendanceRecords Attendance[]
  monthlyPayments   MonthlyPayment[]
  receipts          Receipt[]
  inactivations     InactivationRecord[]
  eventAttendance   EventAttendance[]
  Income            Income[]

  @@index([fullName])
  @@index([parentPhone])
  @@map("students")
}

/// Created automatically when a student hits 5 consecutive absences.
/// The student record itself is never deleted — only its status flips to INACTIVE.
model InactivationRecord {
  id                    String    @id @default(uuid())
  studentId             String
  student               Student   @relation(fields: [studentId], references: [id])
  consecutiveAbsentDays Int
  lastAttendanceDate    DateTime?
  dateMarkedInactive    DateTime  @default(now())
  reason                String    @default("5 consecutive absences")

  @@index([studentId])
  @@map("inactivation_records")
}

// ----------------------------------------------------------------------------
// ATTENDANCE  (Attendance dashboard — schema defined now so Finance can read
// fee status against real students; full attendance UI ships in phase 2)
// ----------------------------------------------------------------------------

model AttendanceEvent {
  id        String       @id @default(uuid())
  date      DateTime
  eventType EventType    @default(SUNDAY_SCHOOL)
  title     String?
  records   Attendance[]

  @@unique([date, eventType, title])
  @@map("attendance_events")
}

model Attendance {
  id           String           @id @default(uuid())
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])
  eventId      String
  event        AttendanceEvent  @relation(fields: [eventId], references: [id])
  status       AttendanceStatus
  recordedById String?
  recordedBy   User?            @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, eventId])
  @@index([studentId])
  @@map("attendance")
}

// ----------------------------------------------------------------------------
// EVENTS
// ----------------------------------------------------------------------------

model Event {
  id                    String      @id @default(uuid())
  name                  String
  date                  DateTime
  eventType             EventType   @default(SUNDAY_SCHOOL)
  description           String?
  participatingClassIds String[]
  status                EventStatus @default(UPCOMING)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  attendance EventAttendance[]

  @@index([date])
  @@map("events")
}

model EventAttendance {
  id        String           @id @default(uuid())
  eventId   String
  event     Event            @relation(fields: [eventId], references: [id])
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  status    AttendanceStatus @default(PRESENT)
  createdAt DateTime         @default(now())

  @@unique([eventId, studentId])
  @@map("event_attendance")
}

// ----------------------------------------------------------------------------
// FINANCE — ETHIOPIAN CALENDAR STUDENT FEE PAYMENTS
// ----------------------------------------------------------------------------

/// One row per student per Ethiopian-calendar year captures the 13-month
/// payment status; MonthlyPayment holds the per-month transaction detail.
model MonthlyPayment {
  id            String         @id @default(uuid())
  studentId     String
  student       Student        @relation(fields: [studentId], references: [id])
  ethiopianYear Int
  month         EthiopianMonth
  status        PaymentStatus  @default(UNPAID)
  baseAmount    Decimal        @default(0) @db.Decimal(12, 2)
  penaltyAmount Decimal        @default(0) @db.Decimal(12, 2)
  amount        Decimal        @db.Decimal(12, 2)
  notes         String?
  paidDate      DateTime?
  recordedById  String?
  recordedBy    User?          @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  receipts Receipt[]
  Income   Income[]

  @@unique([studentId, ethiopianYear, month])
  @@index([studentId])
  @@map("monthly_payments")
}

model Receipt {
  id               String          @id @default(uuid())
  receiptNumber    String          @unique
  studentId        String
  student          Student         @relation(fields: [studentId], references: [id])
  monthlyPaymentId String?
  monthlyPayment   MonthlyPayment? @relation(fields: [monthlyPaymentId], references: [id])
  monthsPaid       String[]
  amount           Decimal         @db.Decimal(12, 2)
  paymentDate      DateTime        @default(now())
  issuedById       String
  issuedBy         User            @relation("ReceiptIssuedBy", fields: [issuedById], references: [id])
  createdAt        DateTime        @default(now())

  income Income? @relation("ReceiptIncome")

  @@map("receipts")
}

model ReceiptPhoto {
  id        String   @id @default(uuid())
  filename  String
  note      String?
  createdAt DateTime @default(now())

  @@map("receipt_photos")
}

// ----------------------------------------------------------------------------
// FINANCE — ACCOUNTS, APPROVALS & RECONCILIATION
// ----------------------------------------------------------------------------

/// Cash boxes / bank accounts that income and expense movements belong to.
///
/// currentBalance is NEVER written by a user-facing endpoint — it only changes
/// as a side effect of recording an Income/Expense (or an opening-balance
/// ledger entry), all inside a single transaction guarded by a row lock. See
/// LedgerService. The audit trail must be able to explain every balance from
/// entry #1 onward, so opening balances are ledger entries, not raw fields.
model Account {
  id             String      @id @default(uuid())
  name           String
  type           AccountType
  bankName       String?
  accountNumber  String?
  currentBalance Decimal     @default(0) @db.Decimal(12, 2)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  incomes         Income[]
  expenses        Expense[]
  reconciliations Reconciliation[]

  @@index([type])
  @@map("accounts")
}

/// Full approval/rejection history for Income and Expense rows. A single row is
/// appended on every decision — the parent's approvedBy/approvedAt fields are
/// only the latest snapshot, never an overwrite of history.
model TransactionApproval {
  id         String           @id @default(uuid())
  incomeId   String?
  income     Income?          @relation(fields: [incomeId], references: [id], onDelete: Cascade)
  expenseId  String?
  expense    Expense?         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  decision   ApprovalDecision
  approverId String
  approver   User             @relation("ApprovalApprover", fields: [approverId], references: [id])
  comments   String?
  decidedAt  DateTime         @default(now())

  @@index([incomeId])
  @@index([expenseId])
  @@map("transaction_approvals")
}

/// Cash/bank reconciliation. expectedBalance, actualBalance and discrepancy are
/// stored, never recomputed from the ledger after the fact, so the history is
/// immutable even if the underlying Income/Expense rows are later corrected.
model Reconciliation {
  id              String               @id @default(uuid())
  accountId       String
  account         Account              @relation(fields: [accountId], references: [id])
  periodStart     DateTime
  periodEnd       DateTime
  expectedBalance Decimal              @db.Decimal(12, 2)
  actualBalance   Decimal              @db.Decimal(12, 2)
  discrepancy     Decimal              @db.Decimal(12, 2)
  status          ReconciliationStatus
  performedById   String
  performedBy     User                 @relation("ReconciliationPerformedBy", fields: [performedById], references: [id])
  resolutionNotes String?
  resolvedById    String?
  resolvedBy      User?                @relation("ReconciliationResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt      DateTime?
  createdAt       DateTime             @default(now())

  @@index([accountId])
  @@index([periodStart, periodEnd])
  @@map("reconciliations")
}

// ----------------------------------------------------------------------------
// FINANCE — INCOME & EXPENSE
// ----------------------------------------------------------------------------

model Income {
  id               String            @id @default(uuid())
  date             DateTime
  amount           Decimal           @db.Decimal(12, 2)
  category         IncomeCategory
  sourceType       IncomeSourceType
  paymentMethod    PaymentMethod
  description      String?
  referenceNumber  String?   @unique
  notes            String?
  status           TransactionStatus @default(PENDING_APPROVAL)
  accountId        String
  account          Account           @relation(fields: [accountId], references: [id])
  /// Account balance after this entry, stamped atomically at write time. Null
  /// only for system-derived rows (e.g. student-fee revenue) that don't move a
  /// bank balance. Never recalculated — corrections go through REVERSAL entries.
  runningBalance Decimal?           @db.Decimal(12, 2)
  receiptId        String?           @unique
  receipt          Receipt?          @relation("ReceiptIncome", fields: [receiptId], references: [id])
  monthlyPaymentId String?
  monthlyPayment   MonthlyPayment?   @relation(fields: [monthlyPaymentId], references: [id])
  studentId        String?
  student          Student?          @relation(fields: [studentId], references: [id])
  recordedById     String
  recordedBy       User              @relation("IncomeRecordedBy", fields: [recordedById], references: [id])
  approvedById     String?
  approvedBy       User?             @relation("IncomeApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  /// Set when this Income is a REVERSAL of an Expense.
  reversesExpenseId String?
  reversesExpense   Expense? @relation("ExpenseReversedByIncome", fields: [reversesExpenseId], references: [id])

  /// Reversal Expenses that undo this Income (append-only correction path).
  reversedByExpense Expense[] @relation("IncomeReversedByExpense")

  approvals TransactionApproval[]

  @@index([sourceType, date])
  @@index([accountId])
  @@index([category, date])
  @@index([studentId])
  @@index([monthlyPaymentId])
  @@map("income")
}

model Expense {
  id                 String            @id @default(uuid())
  date               DateTime
  amount             Decimal           @db.Decimal(12, 2)
  category           ExpenseCategory
  paymentMethod      PaymentMethod
  description        String?
  referenceNumber    String?
  receiptDocumentUrl String?
  notes              String?
  status             TransactionStatus @default(PENDING_APPROVAL)
  accountId          String
  account            Account           @relation(fields: [accountId], references: [id])
  /// Account balance after this entry, stamped atomically at write time. Null
  /// only for system-derived rows that don't move a bank balance. Never
  /// recalculated — corrections go through REVERSAL entries.
  runningBalance Decimal?           @db.Decimal(12, 2)
  recordedById     String
  recordedBy       User              @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])
  approvedById     String?
  approvedBy       User?             @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  /// Set when this Expense is a REVERSAL of an Income.
  reversesIncomeId String?
  reversesIncome   Income?   @relation("IncomeReversedByExpense", fields: [reversesIncomeId], references: [id])

  /// Reversal Incomes that undo this Expense (append-only correction path).
  reversedByIncome Income[]  @relation("ExpenseReversedByIncome")

  approvals TransactionApproval[]

  @@index([category, date])
  @@index([accountId])
  @@map("expenses")
}

// ----------------------------------------------------------------------------
// NOTIFICATIONS
// ----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id])
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ----------------------------------------------------------------------------
// AUDIT LOG  (shared by both dashboards)
// ----------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  changedById String?
  changedBy   User?    @relation("AuditLogChangedBy", fields: [changedById], references: [id])
  action      String // e.g. "PAYMENT_RECORDED", "EXPENSE_CREATED", "ATTENDANCE_EDITED"
  entityType  String // e.g. "MonthlyPayment", "Expense", "Student"
  entityId    String
  reason      String? // mandatory for finance edits (enforced by financeAuditService)
  oldValue    Json?
  newValue    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([changedById])
  @@map("audit_logs")
}

model FinanceReport {
  id            String            @id @default(uuid())
  type          FinanceReportType
  ethiopianYear Int
  month         EthiopianMonth?
  summary       Json
  data          Json
  generatedById String?
  generatedBy   User?             @relation("ReportGeneratedBy", fields: [generatedById], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([type, ethiopianYear, month])
  @@index([type, ethiopianYear])
  @@map("finance_reports")
}
